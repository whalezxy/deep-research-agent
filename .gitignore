# Maven, Vite and locally generated files
/target/
/out/
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/.vite-temp/
/frontend/coverage/
/META-INF/
/e2b-process-fdp.pb
*.class
*.tsbuildinfo

# Logs and JVM crash reports
*.log
hs_err_pid*
replay_pid*

# IDE and OS metadata
/.idea/
/.vscode/
*.iml
.classpath
.project
.settings/
*.ctxt
.mtj.tmp/
.DS_Store
Thumbs.db
Desktop.ini

# Packaged artifacts
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!/.mvn/wrapper/maven-wrapper.jar

# Local credentials and overrides
.env
.env.*
!.env.example
!.env.sample
/config/deep-research-local.properties
/application-local.*
/config/application-local.*
/src/main/resources/application-local.*

# Workspace seeds are versioned separately from tenant data and runtime caches
/workspace/*
!/workspace/AGENTS.md
!/workspace/knowledge/
/workspace/knowledge/*
!/workspace/knowledge/RESEARCH_GUIDE.md
!/workspace/skills/
/workspace/skills/*
!/workspace/skills/.gitkeep
!/workspace/memory/
/workspace/memory/*
!/workspace/memory/.gitkeep
